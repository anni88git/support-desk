# Server Port (default 4000; provided automatically by Render in production)
PORT=4000

# Allowed client origin(s) for CORS (comma-separated, no trailing slashes)
CLIENT_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app

# PostgreSQL Database Connection String (e.g. from Neon Postgres dashboard)
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require

# Optional: Dedicated PostgreSQL Database for running automated tests (must not be same as DATABASE_URL)
TEST_DATABASE_URL=
